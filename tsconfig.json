{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // Scripts run directly via `node` using native type stripping,
    // which only supports erasable TypeScript syntax (no enums etc.).
    "erasableSyntaxOnly": true
  }
}
