const speckAreaSize = {
  width: 1024,
  height: 768,
}
/** Number of colour variants the speckles cycle through. */
const speckleVariantCount = 3
const nByNGridsize = 2 // 2 x 2 grid

/** Maps a speckle's index onto one of the colour variants, cycling 0, 1, 2. */
function speckleVariant(index: number): number {
  return index % speckleVariantCount
}

/**
 * The speckle set repeated across an n x n grid, each copy offset into its own
 * cell of the viewBox.
 */
const tiledSpeckles = Array.from(
  { length: nByNGridsize * nByNGridsize },
  (_, tileIndex) => {
    const column = tileIndex % nByNGridsize
    const row = Math.floor(tileIndex / nByNGridsize)
    return (
      [...specklePathDims]
        // randomly rearrange the order to any colouring pattern applied is random too
        .sort(() => (Math.random() > 0.5 ? 1 : -1))
        .map(dim => ({
          dim,
          x: column * speckAreaSize.width,
          y: row * speckAreaSize.height,
        }))
    )
  },
).flat()

type Props = {
  class?: string
}

const { class: className } = Astro.props as Props
---

<svg
  class:list={["speckles-background", className]}
  viewBox={`0 0 ${speckAreaSize.width * nByNGridsize} ${speckAreaSize.height * nByNGridsize}`}
  preserveAspectRatio="xMidYMid slice"
>
  {
    tiledSpeckles.map(({ dim, x, y }, index) => (
      <path
        d={dim}
        class:list={["speckle", `speckle-${speckleVariant(index)}`]}
        transform={`translate(${x}, ${y})`}
      />
    ))
  }
</svg>

<style>
  @layer components {
    .speckles-background {
      position: fixed;
      inset: 0;
      z-index: 0;
      width: 100dvw;
      height: 100dvh;
      pointer-events: none;

      & .speckle {
        filter: blur(1px) opacity(0.7);
      }

      & .speckle.speckle-0 {
        fill: light-dark(var(--colour-blue-200), var(--colour-flamingo-800));
      }

      & .speckle.speckle-1 {
        fill: light-dark(var(--colour-mustard-200), var(--colour-mustard-800));
      }

      & .speckle.speckle-2 {
        fill: light-dark(var(--colour-green-200), var(--colour-green-800));
      }
    }
  }
</style>
