---
import "@fontsource/armata/400.css"
import "@fontsource/fira-code/400.css"
import "@fontsource/montserrat/500.css"
import "../assets/index.css"
import ColorSchemeSwitch from "../components/color-scheme-switch.tsx"
import SpecklesBackground from "../components/speckles-background.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <style is:inline type="text/css">
      /*
      Sequence of CSS layers.
      - tokens: serves a basis for the the whole design system.
      - defaults: sets up the default styles for html elements.
      - components: styles for the individual components.
      - utils: utility classes, which can be used to customise styles.
      
      NOTE: Defined here to ensure that it is used
      by all css loaded subsequently. 
      */
      @layer tokens, defaults, components, utils;
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Tech Conferences Map</title>
  </head>
  <body class="body-text">
    <SpecklesBackground />
    <header class="page-header page-level-container">
      <h1 class="h2-heading">
        Tech Conferences Map

        <span class="subheading"
          >all of the worlds tech conferences on one map</span
        >
      </h1>
      <ColorSchemeSwitch client:only="react" />
    </header>
    <div class="page-content page-level-container">
      <slot />
    </div>
    <footer class="page-footer page-level-container">
      <p>
        Concept and design by <a href="https://sanstream.nl" target="_blank">
          Studio Sanstream
        </a> &copy; {new Date().getFullYear()}
      </p>
      <p>
        City data by <a
          href="https://simplemaps.com/data/world-cities"
          target="_blank">SimpleMaps.com</a
        >, licensed under <a
          href="https://creativecommons.org/licenses/by/4.0/"
          target="_blank">CC BY 4.0</a
        >
      </p>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    position: relative;
    isolation: isolate;
    background-color: var(--colour-main-bg);
  }

  body > * {
    z-index: 1;
  }

  .page-header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    box-shadow: var(--shadow-sm);
    background-color: light-dark(
      var(--colour-flamingo-200),
      var(--colour-blue-900)
    );

    & h1 {
      margin: 0;
      color: light-dark(var(--colour-blue-700), var(--colour-flamingo-300));
    }

    & .subheading {
      font-size: 0.875rem;
      display: block;
      color: var(--colour-body-text);
    }

    & .color-scheme-switch {
      display: flex;
      gap: 0.5rem;
    }
  }

  .page-content {
    overflow-y: auto;
    display: grid;
    grid-template-rows: 1fr;
  }

  .page-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    column-gap: 1.5rem;
    box-shadow: var(--shadow-sm);
    background-color: light-dark(
      var(--colour-flamingo-200),
      var(--colour-blue-900)
    );
    color: var(--colour-body-text);

    & p {
      margin: 0;
    }
  }
</style>
