---
import MapApp from "@/components/search/map-app"
import Layout from "@/layouts/Layout.astro"
import { getConferenceMapMarkers } from "@/lib/conference-map"
import {
  getAllConferences,
  getLocationIndex,
  getSubjectIndex,
} from "@/lib/conferences"

const conferences = await getAllConferences()
const markers = getConferenceMapMarkers(conferences)
const subjects = getSubjectIndex(conferences)
const locations = getLocationIndex(conferences)
---

<Layout>
  <main class="main-content">
    <MapApp
      client:load
      markers={markers}
      subjects={subjects}
      locations={locations}
    />
  </main>
</Layout>

<style is:global>
  .main-content {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
    grid-template-areas:
      "filters"
      "results";
  }

  .main-content .main-content-filters {
    grid-area: filters;
  }

  .main-content .filters-heading {
    grid-area: heading;
  }

  .main-content .main-content-results {
    grid-area: results;
  }
</style>
