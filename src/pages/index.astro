---
import ConferenceResults from "@/components/conference-results/server"
import Placeholder from "@/components/placeholder.astro"
import Layout from "@/layouts/Layout.astro"
import { getConferenceMapMarkers } from "@/lib/conference-map"
import { getAllConferences, getSubjectIndex } from "@/lib/conferences"
import ConferenceFilters from "@/components/conference-filters"

const conferences = await getAllConferences()
const markers = getConferenceMapMarkers(conferences)
const subjects = getSubjectIndex(conferences)
---

<Layout>
  <main class="main-content">
    <header class="main-content-filters">
      <h2 class="h3-heading filters-heading">
        Filter the map using these option:
      </h2>
      <ConferenceFilters client:load subjects={subjects} />
    </header>
    <div class="main-content-results">
      <ConferenceResults markers={markers} />
    </div>
  </main>
</Layout>

<style>
  .main-content {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
    grid-template-areas:
      "filters"
      "results";
  }

  .main-content-filters {
    grid-area: filters;
    display: grid;
    grid-template-areas:
      "heading heading heading"
      "field1 field2 field3";
    grid-auto-flow: column;
    align-items: center;
    gap: 1rem;

    & .filters-heading {
      grid-area: heading;
      margin: 0;
    }

    & .filters-field1 {
      grid-area: field1;
    }
    & .filters-field2 {
      grid-area: field2;
    }
    & .filters-field3 {
      grid-area: field3;
    }
  }

  .main-content-results {
    grid-area: results;
    overflow-x: auto;
    overflow-y: auto;
    scroll-behavior: smooth;
    scrollbar-width: thin;
  }
</style>
