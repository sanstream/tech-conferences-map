---
import KitchenSinkDemo from "@/components/kitchensink/demo"
import Layout from "@/layouts/Layout.astro"
import { getAllConferences, getSubjectIndex } from "@/lib/conferences"

const conferences = await getAllConferences()
const subjects = getSubjectIndex(conferences)
---

<Layout>
  <main class="kitchensink-page">
    <header class="kitchensink-header">
      <h2 class="h3-heading">Kitchen Sink</h2>
      <p>Component showcase for buttons and combobox.</p>
    </header>
    <KitchenSinkDemo client:load subjects={subjects} />
  </main>
</Layout>

<style>
  .kitchensink-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1rem 0 2rem;
  }

  .kitchensink-header {
    & h2 {
      margin-bottom: 0.5rem;
    }

    & p {
      margin: 0;
      color: var(--colour-body-text);
    }
  }

  :global(.kitchensink) {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  :global(.kitchensink-section) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(.kitchensink-section .h3-heading) {
    margin: 0;
  }

  :global(.kitchensink-subsection) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.kitchensink-label) {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: light-dark(var(--colour-flamingo-800), var(--colour-blue-200));
  }

  :global(.kitchensink-description) {
    margin: 0;
    font-size: 0.875rem;
    color: var(--colour-body-text);
  }

  :global(.kitchensink-button-grid) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.kitchensink-button-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.kitchensink-row-label) {
    min-width: 5.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: light-dark(var(--colour-flamingo-700), var(--colour-blue-300));
  }

  :global(.kitchensink-icon-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.kitchensink-selection) {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: var(--colour-body-text);
  }
</style>
